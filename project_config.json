{
  "vocabulary_size": 2000,
  "stopword_mode": "vocab_only",
  "metrics": {
    "cosine_similarity_sentences_BERT": true,
    "jaccard_similarity": false,
    "semantic_token_overlap": true
  },
  "heuristic": {
    "name": "pos_aware",
    "local_context_weight": 0.15,
    "local_context_window": -1,
    "top_k_candidates": 5
  }
}
